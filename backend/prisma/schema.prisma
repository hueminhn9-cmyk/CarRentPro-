generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt?
  action      String    @db.VarChar(100)
  entity_name String?   @db.VarChar(50)
  entity_id   BigInt?
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([action], map: "idx_audit_action")
  @@index([user_id], map: "idx_audit_user")
}

model booking_services {
  id           BigInt    @id @default(autoincrement())
  booking_id   BigInt
  service_name String    @db.VarChar(150)
  quantity     Int       @default(1)
  unit_price   Decimal   @db.Decimal(12, 2)
  total_price  Decimal   @db.Decimal(12, 2)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  bookings     bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_service_booking")

  @@index([booking_id], map: "idx_booking_service_booking")
}

model booking_status_history {
  id         BigInt                        @id @default(autoincrement())
  booking_id BigInt
  status     booking_status_history_status
  changed_by BigInt
  reason     String?                       @db.Text
  created_at DateTime?                     @default(now()) @db.Timestamp(0)
  bookings   bookings                      @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_history_booking")
  users      users                         @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_history_user")

  @@index([booking_id], map: "idx_history_booking")
  @@index([changed_by], map: "idx_history_user")
}

model bookings {
  id                     BigInt                   @id @default(autoincrement())
  booking_code           String                   @unique(map: "booking_code") @db.VarChar(20)
  customer_id            BigInt
  vehicle_id             BigInt
  pickup_datetime        DateTime                 @db.DateTime(0)
  return_datetime        DateTime                 @db.DateTime(0)
  pickup_location        String                   @db.VarChar(255)
  return_location        String                   @db.VarChar(255)
  rental_days            Int
  rental_fee             Decimal                  @db.Decimal(12, 2)
  service_fee            Decimal?                 @default(0.00) @db.Decimal(12, 2)
  discount_amount        Decimal?                 @default(0.00) @db.Decimal(12, 2)
  deposit_amount         Decimal                  @db.Decimal(12, 2)
  surcharge_amount       Decimal?                 @default(0.00) @db.Decimal(12, 2)
  total_amount           Decimal                  @db.Decimal(12, 2)
  status                 bookings_status?         @default(PENDING)
  payment_status         bookings_payment_status? @default(UNPAID)
  customer_note          String?                  @db.Text
  admin_note             String?                  @db.Text
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  booking_services       booking_services[]
  booking_status_history booking_status_history[]
  users                  users                    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_customer")
  vehicles               vehicles                 @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_vehicle")
  contracts              contracts?
  handover_records       handover_records[]
  payments               payments[]
  reviews                reviews?

  @@index([customer_id], map: "idx_booking_customer")
  @@index([payment_status], map: "idx_booking_payment")
  @@index([status], map: "idx_booking_status")
  @@index([vehicle_id], map: "idx_booking_vehicle")
}

model contracts {
  id            BigInt           @id @default(autoincrement())
  booking_id    BigInt           @unique(map: "booking_id")
  contract_code String           @unique(map: "contract_code") @db.VarChar(50)
  contract_url  String?          @db.VarChar(500)
  status        contracts_status @default(PENDING_SIGN)
  signed_at     DateTime?        @db.Timestamp(0)
  created_at    DateTime?        @default(now()) @db.Timestamp(0)
  updated_at    DateTime?        @default(now()) @db.Timestamp(0)
  bookings      bookings         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contract_booking")
}

model customer_profiles {
  id                    BigInt                                 @id @default(autoincrement())
  user_id               BigInt                                 @unique(map: "user_id")
  date_of_birth         DateTime?                              @db.Date
  address               String?                                @db.Text
  citizen_id            String?                                @unique(map: "citizen_id") @db.VarChar(20)
  driver_license_number String?                                @unique(map: "driver_license_number") @db.VarChar(20)
  driver_license_expiry DateTime?                              @db.Date
  verification_status   customer_profiles_verification_status? @default(PENDING)
  created_at            DateTime?                              @default(now()) @db.Timestamp(0)
  updated_at            DateTime?                              @default(now()) @db.Timestamp(0)
  users                 users                                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model handover_records {
  id                 BigInt                              @id @default(autoincrement())
  booking_id         BigInt
  record_type        handover_records_record_type
  recorded_by        BigInt
  recorded_at        DateTime?                           @default(now()) @db.Timestamp(0)
  mileage            Int
  fuel_level         Int                                 @db.TinyInt
  vehicle_condition  handover_records_vehicle_condition? @default(GOOD)
  damage_description String?                             @db.Text
  late_fee           Decimal?                            @default(0.00) @db.Decimal(12, 2)
  extra_km_fee       Decimal?                            @default(0.00) @db.Decimal(12, 2)
  fuel_fee           Decimal?                            @default(0.00) @db.Decimal(12, 2)
  cleaning_fee       Decimal?                            @default(0.00) @db.Decimal(12, 2)
  damage_fee         Decimal?                            @default(0.00) @db.Decimal(12, 2)
  total_surcharge    Decimal?                            @default(0.00) @db.Decimal(12, 2)
  refundable_deposit Decimal?                            @default(0.00) @db.Decimal(12, 2)
  note               String?                             @db.Text
  created_at         DateTime?                           @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                           @default(now()) @db.Timestamp(0)
  bookings           bookings                            @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_handover_booking")
  users              users                               @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_handover_user")

  @@index([booking_id], map: "idx_handover_booking")
  @@index([recorded_by], map: "idx_handover_recorded_by")
  @@index([record_type], map: "idx_handover_type")
}

model maintenance_records {
  id                 BigInt                      @id @default(autoincrement())
  vehicle_id         BigInt
  maintenance_type   String                      @db.VarChar(100)
  scheduled_date     DateTime                    @db.Date
  completed_date     DateTime?                   @db.Date
  mileage_at_service Int?
  next_service_date  DateTime?                   @db.Date
  cost               Decimal?                    @default(0.00) @db.Decimal(12, 2)
  status             maintenance_records_status? @default(SCHEDULED)
  description        String?                     @db.Text
  created_by         BigInt
  created_at         DateTime?                   @default(now()) @db.Timestamp(0)
  users              users                       @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_user")
  vehicles           vehicles                    @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_vehicle")

  @@index([created_by], map: "fk_maintenance_user")
  @@index([status], map: "idx_maintenance_status")
  @@index([vehicle_id], map: "idx_maintenance_vehicle")
}

model media_files {
  id               BigInt                        @id @default(autoincrement())
  entity_type      media_files_entity_type
  entity_id        BigInt
  media_type       media_files_media_type        @default(IMAGE)
  category         media_files_category?         @default(OTHER)
  original_name    String                        @db.VarChar(255)
  stored_name      String                        @db.VarChar(255)
  file_extension   String?                       @db.VarChar(20)
  mime_type        String?                       @db.VarChar(100)
  file_size        BigInt?                       @default(0)
  file_path        String                        @db.VarChar(500)
  thumbnail_path   String?                       @db.VarChar(500)
  storage_provider media_files_storage_provider? @default(LOCAL)
  is_primary       Boolean?                      @default(false)
  sort_order       Int?                          @default(0)
  uploaded_by      BigInt?
  description      String?                       @db.Text
  created_at       DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at       DateTime?                     @default(now()) @db.Timestamp(0)
  users            users?                        @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "fk_media_user")

  @@index([category], map: "idx_media_category")
  @@index([created_at], map: "idx_media_created")
  @@index([entity_type, entity_id], map: "idx_media_entity")
  @@index([is_primary], map: "idx_media_primary")
  @@index([uploaded_by], map: "idx_media_uploaded")
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  title      String    @db.VarChar(255)
  content    String    @db.Text
  type       String?   @default("SYSTEM") @db.VarChar(50)
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")

  @@index([user_id, is_read], map: "idx_notification_unread")
  @@index([user_id], map: "idx_notification_user")
}

model payments {
  id                BigInt                    @id @default(autoincrement())
  transaction_code  String                    @unique(map: "transaction_code") @db.VarChar(30)
  booking_id        BigInt
  customer_id       BigInt
  transaction_type  payments_transaction_type
  amount            Decimal                   @db.Decimal(12, 2)
  payment_method    payments_payment_method
  status            payments_status?          @default(PENDING)
  payment_reference String?                   @db.VarChar(255)
  paid_at           DateTime?                 @db.Timestamp(0)
  created_at        DateTime?                 @default(now()) @db.Timestamp(0)
  bookings          bookings                  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_booking")
  users             users                     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_customer")

  @@index([booking_id], map: "idx_payment_booking")
  @@index([customer_id], map: "idx_payment_customer")
  @@index([status], map: "idx_payment_status")
}

model refresh_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token      String    @unique(map: "token") @db.VarChar(500)
  expires_at DateTime  @db.DateTime(0)
  is_revoked Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_user")

  @@index([user_id], map: "idx_refresh_token_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id          BigInt    @id @default(autoincrement())
  booking_id  BigInt    @unique(map: "booking_id")
  customer_id BigInt
  vehicle_id  BigInt
  rating      Int       @db.TinyInt
  content     String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  bookings    bookings  @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_booking")
  users       users     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_customer")
  vehicles    vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_review_vehicle")

  @@index([customer_id], map: "idx_review_customer")
  @@index([vehicle_id], map: "idx_review_vehicle")
}

model settings {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique(map: "key") @db.VarChar(100)
  value       String    @db.Text
  description String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
}

model users {
  id                     BigInt                   @id @default(autoincrement())
  full_name              String                   @db.VarChar(100)
  email                  String                   @unique(map: "email") @db.VarChar(100)
  phone                  String?                  @unique(map: "phone") @db.VarChar(20)
  password_hash          String                   @db.VarChar(255)
  role                   users_role               @default(CUSTOMER)
  status                 users_status?            @default(ACTIVE)
  avatar_url             String?                  @db.VarChar(255)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  audit_logs             audit_logs[]
  booking_status_history booking_status_history[]
  bookings               bookings[]
  customer_profiles      customer_profiles?
  handover_records       handover_records[]
  maintenance_records    maintenance_records[]
  media_files            media_files[]
  notifications          notifications[]
  payments               payments[]
  refresh_tokens         refresh_tokens[]
  reviews                reviews[]
}

model vehicle_categories {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique(map: "name") @db.VarChar(100)
  description String?    @db.Text
  created_at  DateTime?  @default(now()) @db.Timestamp(0)
  updated_at  DateTime?  @default(now()) @db.Timestamp(0)
  vehicles    vehicles[]
}

model vehicles {
  id                  BigInt                @id @default(autoincrement())
  category_id         BigInt
  code                String                @unique(map: "code") @db.VarChar(20)
  name                String                @db.VarChar(150)
  brand               String                @db.VarChar(100)
  model               String                @db.VarChar(100)
  manufacture_year    Int?
  license_plate       String                @unique(map: "license_plate") @db.VarChar(20)
  color               String?               @db.VarChar(50)
  seat_count          Int
  transmission        vehicles_transmission
  fuel_type           vehicles_fuel_type
  current_mileage     Int?                  @default(0)
  price_per_day       Decimal               @db.Decimal(12, 2)
  deposit_amount      Decimal               @db.Decimal(12, 2)
  included_km_per_day Int?                  @default(200)
  extra_km_fee        Decimal?              @default(3000.00) @db.Decimal(12, 2)
  location            String?               @default("Hà Nội") @db.VarChar(100)
  description         String?               @db.Text
  status              vehicles_status?      @default(AVAILABLE)
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?             @default(now()) @db.Timestamp(0)
  bookings            bookings[]
  maintenance_records maintenance_records[]
  reviews             reviews[]
  vehicle_categories  vehicle_categories    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_vehicle_category")

  @@index([brand], map: "idx_vehicle_brand")
  @@index([category_id], map: "idx_vehicle_category")
  @@index([status], map: "idx_vehicle_status")
}

enum media_files_entity_type {
  VEHICLE
  CUSTOMER_PROFILE
  BOOKING
  HANDOVER_RECORD
  REVIEW
  PAYMENT
}

enum booking_status_history_status {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  ACTIVE
  WAITING_FOR_RETURN
  COMPLETED
  CANCELLED
  REJECTED
  OVERDUE
}

enum handover_records_record_type {
  PICKUP
  RETURN
}

enum media_files_media_type {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
}

enum contracts_status {
  PENDING_SIGN
  SIGNED
  TERMINATED
  CANCELLED
}

enum media_files_category {
  VEHICLE_FRONT
  VEHICLE_BACK
  VEHICLE_LEFT
  VEHICLE_RIGHT
  VEHICLE_INTERIOR
  VEHICLE_ENGINE
  CITIZEN_FRONT
  CITIZEN_BACK
  LICENSE_FRONT
  LICENSE_BACK
  PASSPORT
  HANDOVER_FRONT
  HANDOVER_BACK
  HANDOVER_LEFT
  HANDOVER_RIGHT
  HANDOVER_INTERIOR
  HANDOVER_DASHBOARD
  HANDOVER_ODOMETER
  HANDOVER_FUEL
  HANDOVER_DAMAGE
  PAYMENT_RECEIPT
  REVIEW_IMAGE
  OTHER
}

enum payments_transaction_type {
  DEPOSIT
  RENTAL
  SERVICE_FEE
  SURCHARGE
  REFUND
}

enum users_role {
  ADMIN
  MANAGER
  CUSTOMER
}

enum payments_payment_method {
  CASH
  BANK_TRANSFER
  VNPAY
  MOMO
  CREDIT_CARD
  OTHER
}

enum users_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum customer_profiles_verification_status {
  PENDING
  VERIFIED
  REJECTED
}

enum handover_records_vehicle_condition {
  EXCELLENT
  GOOD
  NORMAL
  DAMAGED
}

enum payments_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum maintenance_records_status {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum vehicles_transmission {
  AUTO
  MANUAL
}

enum vehicles_fuel_type {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum media_files_storage_provider {
  LOCAL
  S3
  CLOUDINARY
}

enum bookings_status {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  ACTIVE
  WAITING_FOR_RETURN
  COMPLETED
  CANCELLED
  REJECTED
  OVERDUE
}

enum bookings_payment_status {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum vehicles_status {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
  INCIDENT
}
